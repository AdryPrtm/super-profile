BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
CORS_ORIGIN=
DATABASE_URL=

# Public Supabase Storage bucket for project images and the downloadable CV PDF.
# Allow application/pdf uploads (up to 10 MB) in this bucket.
