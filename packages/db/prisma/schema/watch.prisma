model WatchEntry {
  id        String    @id @default(cuid())
  title     String
  category  String
  status    String
  source    String    @default("manual")
  externalId String?   @unique
  year      Int?
  posterUrl String?
  rating    Int?
  notes     String?
  tracking  Json      @default("{}")
  watchedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([category, status])
  @@index([watchedAt])
  @@index([source])
  @@map("watch_entries")
}
