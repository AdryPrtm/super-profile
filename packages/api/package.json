{
  "name": "@super-profile-dry/api",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@trpc/server": "catalog:",
    "@trpc/client": "catalog:",
    "next": "catalog:",
    "dotenv": "catalog:",
    "zod": "catalog:",
    "@super-profile-dry/auth": "workspace:*",
    "@super-profile-dry/db": "workspace:*"
  }
}
