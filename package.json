{
  "name": "super-profile-dry",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "next": "16.0.0",
      "zod": "^4.1.12",
      "@trpc/server": "^11.5.0",
      "@trpc/client": "^11.5.0",
      "@prisma/client": "^6.15.0",
      "better-auth": "^1.3.28",
      "dotenv": "^17.2.2",
      "tsdown": "^0.15.5"
    }
  },
  "scripts": {
    "prepare": "husky",
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter web check-types && bun run --filter @super-profile-dry/api check-types && bun run --filter @super-profile-dry/auth check-types && bun run --filter @super-profile-dry/db check-types",
    "dev:native": "bun run --filter native dev",
    "dev:web": "bun run --filter web dev",
    "db:push": "bun run --filter @super-profile-dry/db db:push",
    "db:studio": "bun run --filter @super-profile-dry/db db:studio",
    "db:generate": "bun run --filter @super-profile-dry/db db:generate",
    "db:migrate": "bun run --filter @super-profile-dry/db db:migrate"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.13.11",
    "baseline-browser-mapping": "^2.11.20",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "tsdown": "^0.15.5"
  },
  "packageManager": "bun@1.3.0"
}
